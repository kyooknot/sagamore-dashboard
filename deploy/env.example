# /etc/sagamore/env  — mode 600, owned by the sagamore user.
# Rendered at DEPLOY time (op inject / infisical), never fetched at runtime, so
# the vault being down can never take the dashboard offline.

# --- Home Assistant (required for every house panel) ---
HA_URL=http://192.168.1.20:8123
HA_TOKEN=

# --- Proxmox (required for the homelab panel) ---
# A read-only API token is enough: PVEAuditor on / is sufficient.
PVE_HOST=https://192.168.1.24:8006
PVE_TOKEN_ID=root@pam!sagamore
PVE_TOKEN_SECRET=
PVE_NODES=pve,pve3,pve4
PVE_VERIFY_TLS=false

# --- Optional: bookmark store (Nextcloud Bookmarks) ---
# NEXTCLOUD_PASSWORD must be an *app password* (Settings -> Security -> Devices &
# sessions), never the account password: revocable on its own, and unaffected if
# SSO is later put in front of Nextcloud.
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_INBOX=Inbox

# --- Optional ---
CERT_HOST=ha.example.com
DB_PATH=/var/lib/sagamore/sagamore.db
POLL_SECONDS=60
SLOW_POLL_SECONDS=900
TZ=America/New_York
